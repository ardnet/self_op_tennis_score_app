# Browser-safe variables, baked into the build by Vite.
# Set these on the Render Static Site (Environment) and in a local .env.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Optional: Live Scoreboard API location. Defaults to <VITE_SUPABASE_URL>/functions/v1.
# For local function testing: http://127.0.0.1:54321/functions/v1
# VITE_LIVE_API_BASE_URL=

# Legacy fallback if your project still uses legacy keys:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Google Analytics 4 - Web App stream
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# No server secret is needed here any more: the Supabase Edge Functions
# receive SUPABASE_URL and the project's secret key from Supabase automatically.
